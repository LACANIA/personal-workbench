{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../desktop-dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
